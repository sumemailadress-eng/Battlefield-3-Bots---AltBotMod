-        [void]$words.Add([Text.Encoding]::UTF8.GetString($body, $o + 4, [int]$len))
-        $o += 5 + [int]$len
-    }
-    return [pscustomobject]@{ Sequence = $seq; Words = [string[]]$words.ToArray() }
-}
