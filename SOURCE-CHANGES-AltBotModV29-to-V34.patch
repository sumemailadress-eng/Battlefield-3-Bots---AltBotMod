-    $got = 0
-    while ($got -lt $count) {
-        $r = $stream.Read($buf, $got, $count - $got)
-        if ($r -le 0) { throw 'RCON connection closed' }
-        $got += $r
-    }
-    return ,$buf
-}
-function Read-BmRconPacket($stream) {
