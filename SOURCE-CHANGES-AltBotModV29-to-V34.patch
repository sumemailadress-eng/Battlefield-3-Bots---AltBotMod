-            set = new Dictionary<long, int>[4]; for (int i = 0; i < 4; i++) set[i] = new Dictionary<long, int>();
-            HeatBy[k] = set;
-        }
-        long c = Key(x, z); int n; set[layer].TryGetValue(c, out n); set[layer][c] = n + 1;
-    }
