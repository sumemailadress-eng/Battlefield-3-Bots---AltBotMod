-                return new int[] { R(70 + 150 * t), R(a[1] + (b[1] - a[1]) * u), R(a[2] + (b[2] - a[2]) * u), R(a[3] + (b[3] - a[3]) * u) };   // (rounded like PowerShell's [int])
-            }
-        }
